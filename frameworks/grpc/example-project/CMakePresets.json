{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21 },
  "configurePresets": [
    {
      "name": "_base",
      "hidden": true,
      "architecture": { "value": "x64", "strategy": "set" },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{GRPC_ROOT}/grpc-toolchain.cmake",
        "CMAKE_PREFIX_PATH": "$env{GRPC_ROOT}"
      }
    },
    {
      "name": "vs2026-v143",
      "displayName": "VS 2026 - v143 toolset (use the msvc143 package)",
      "inherits": "_base",
      "generator": "Visual Studio 18 2026",
      "toolset": "v143,version=14.44.35207",
      "binaryDir": "${sourceDir}/build/vs2026-v143"
    },
    {
      "name": "vs2026-v145",
      "displayName": "VS 2026 - v145 toolset (use the msvc145 package)",
      "inherits": "_base",
      "generator": "Visual Studio 18 2026",
      "toolset": "v145,version=14.51.36231",
      "binaryDir": "${sourceDir}/build/vs2026-v145"
    },
    {
      "name": "vs2022-v143",
      "displayName": "VS 2022 - v143 toolset (use the msvc143 package)",
      "inherits": "_base",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/vs2022-v143"
    },
    {
      "name": "vs2019-v142",
      "displayName": "VS 2019 - v142 toolset (use the msvc142 package)",
      "inherits": "_base",
      "generator": "Visual Studio 16 2019",
      "binaryDir": "${sourceDir}/build/vs2019-v142"
    }
  ],
  "buildPresets": [
    { "name": "vs2026-v143-release", "configurePreset": "vs2026-v143", "configuration": "Release" },
    { "name": "vs2026-v143-debug",   "configurePreset": "vs2026-v143", "configuration": "Debug" },
    { "name": "vs2026-v145-release", "configurePreset": "vs2026-v145", "configuration": "Release" },
    { "name": "vs2026-v145-debug",   "configurePreset": "vs2026-v145", "configuration": "Debug" },
    { "name": "vs2022-v143-release", "configurePreset": "vs2022-v143", "configuration": "Release" },
    { "name": "vs2022-v143-debug",   "configurePreset": "vs2022-v143", "configuration": "Debug" },
    { "name": "vs2019-v142-release", "configurePreset": "vs2019-v142", "configuration": "Release" },
    { "name": "vs2019-v142-debug",   "configurePreset": "vs2019-v142", "configuration": "Debug" }
  ]
}
